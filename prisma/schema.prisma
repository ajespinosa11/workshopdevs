generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   // "ADMIN" or "RECEPTIONIST"
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdTransactions CreditTransaction[]
  checkedInAttendances Attendance[]
  approvedRegistrations WorkshopRegistration[]
  rescheduleLogs        RescheduleLog[]
  auditLogs             AuditTrail[]
}

model Module {
  id            String   @id @default(uuid())
  name          String
  description   String?
  category      String   // BEGINNER, INTERMEDIATE, ADVANCED
  units         Int      // Number of units this module costs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      WorkshopSession[]
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  description   String?
  price         Float
  creditUnits   Int      // Renamed from creditHours
  isActive      Boolean  @default(true)
  storehubSku   String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vouchers      Voucher[]
  requests      PlanRequest[]
}

model PlanRequest {
  id                    String   @id @default(uuid())
  customerName          String
  customerEmail         String
  customerPhone         String
  selectedPlanId        String
  selectedPlan          Plan     @relation(fields: [selectedPlanId], references: [id])
  status                String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, REJECTED
  adminNotes            String?
  storehubTransactionId String?  @unique
  emailSentAt           DateTime? // Tracks when the voucher email was last sent
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  vouchers         Voucher[]
}

model Voucher {
  id                     String   @id @default(uuid())
  voucherCode            String   @unique
  qrCodeData             String?  
  customerName           String
  customerEmail          String
  customerPhone          String
  planId                 String
  plan                   Plan     @relation(fields: [planId], references: [id])
  sourcePlanRequestId    String?
  sourcePlanRequest      PlanRequest? @relation(fields: [sourcePlanRequestId], references: [id])
  totalUnits             Int      // Renamed from totalCreditHours
  remainingUnits         Int      // Renamed from remainingCreditHours
  status                 String   @default("ACTIVE") // ACTIVE, FULLY_USED, SUSPENDED, CANCELLED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  bookings               Booking[]
  transactions           CreditTransaction[]
  attendances            Attendance[]
}

model WorkshopSession {
  id               String   @id @default(uuid())
  moduleId         String
  module           Module   @relation(fields: [moduleId], references: [id])
  category         String   // BEGINNER, INTERMEDIATE, ADVANCED (for backward compatibility / quick queries)
  sessionDate      DateTime
  startTime        String
  endTime          String
  durationHours    Int
  capacity         Int      @default(20)
  availableSlots   Int
  status           String   @default("OPEN") // OPEN, FULL, CANCELLED, COMPLETED
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings         Booking[]
  attendances      Attendance[]
  registrations    WorkshopRegistration[]
}

model Booking {
  id                      String   @id @default(uuid())
  bookingReference        String   @unique
  bookingQrCodeData       String?
  voucherId               String
  voucher                 Voucher  @relation(fields: [voucherId], references: [id])
  sessionId               String
  session                 WorkshopSession @relation(fields: [sessionId], references: [id])
  customerName            String
  customerEmail           String
  customerPhone           String
  status                  String   @default("RESERVED") // RESERVED, BALANCE_DUE, CANCELLED_BY_CUSTOMER, RELEASED_TO_WALKIN, NO_SHOW, CHECKED_IN, COMPLETED_CONSUMED, WALKIN_CONFIRMED
  sessionDurationHours    Int
  unitsToDeduct           Int      // Renamed from creditHoursToDeduct
  balanceDueUnits         Int      @default(0) // Renamed from balanceDueHours
  balanceDueAmount        Float    @default(0)
  balanceDuePaid          Boolean  @default(true)
  checkedInAt             DateTime?
  cancelledAt             DateTime?
  notes                   String?
  companionName           String?
  kidName                 String?
  rescheduled             Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  transactions            CreditTransaction[]
  attendance              Attendance?
}

model CreditTransaction {
  id                    String   @id @default(uuid())
  voucherId             String
  voucher               Voucher  @relation(fields: [voucherId], references: [id])
  bookingId             String?
  booking               Booking? @relation(fields: [bookingId], references: [id])
  transactionType       String   // CREDIT_ADDED, CREDIT_DEDUCTED, MANUAL_ADJUSTMENT, BALANCE_DUE_PAYMENT
  unitsAdded            Int      @default(0) // Renamed from hoursAdded
  unitsDeducted         Int      @default(0) // Renamed from hoursDeducted
  amountPaid            Float    @default(0)
  description           String?
  createdByStaffId      String?
  createdByStaff        StaffUser? @relation(fields: [createdByStaffId], references: [id])
  createdAt             DateTime @default(now())
}


model Attendance {
  id                    String   @id @default(uuid())
  bookingId             String   @unique
  booking               Booking  @relation(fields: [bookingId], references: [id])
  voucherId             String
  voucher               Voucher  @relation(fields: [voucherId], references: [id])
  sessionId             String
  session               WorkshopSession @relation(fields: [sessionId], references: [id])
  checkInMethod         String   // VOUCHER_QR, MANUAL_ENTRY, WALK_IN
  checkedInByStaffId    String
  checkedInByStaff      StaffUser @relation(fields: [checkedInByStaffId], references: [id])
  checkedInAt           DateTime @default(now())
  notes                 String?
}

model SystemSetting {
  id            String   @id @default(uuid())
  settingKey    String   @unique
  settingValue  String
}

model DiscountCode {
  id          String    @id @default(uuid())
  code        String    @unique
  eventName   String
  isUsed      Boolean   @default(false)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WorkshopRegistration {
  id                      String             @id @default(uuid())
  bookingReference        String             @unique
  salesChannel            String             @default("SHOPIFY") // SHOPIFY, STOREHUB, MANUAL_REGISTRATION, COMPLIMENTARY, OTHER
  sku                     String             @default("BW001")
  
  customerName            String
  customerEmail           String
  customerPhone           String
  participantsCount       Int                @default(1)
  branchLocation          String?
  notes                   String?

  sessionId               String?
  session                 WorkshopSession?   @relation(fields: [sessionId], references: [id])
  
  status                  String             @default("AWAITING_PAYMENT") 
  // Statuses: AWAITING_PAYMENT, PAYMENT_PENDING, PAID_FOR_ADMIN_VERIFICATION, PENDING_SCHEDULE_CONFIRMATION, RESERVED, CONFIRMED, WAITING_LIST, RESCHEDULING_REQUESTED, RESCHEDULED, ATTENDED, NO_SHOW, CANCELLED, REFUNDED, PARTIALLY_REFUNDED, DUPLICATE_ORDER
  
  shopifyOrder            ShopifyOrder?
  storehubTransactionId   String?            @unique
  
  approvedByStaffId       String?
  approvedByStaff         StaffUser?         @relation(fields: [approvedByStaffId], references: [id])
  reservedAt              DateTime?
  reservedUntil           DateTime?          // Soft-lock expiration (15 mins from checkout start)
  
  capacityOverridden      Boolean            @default(false)
  overrideReason          String?
  rescheduleHistory       RescheduleLog[]

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  auditLogs               AuditTrail[]
}

model ShopifyOrder {
  id                    String               @id @default(uuid())
  shopifyOrderId        String               @unique
  shopifyOrderNumber     String
  registrationId        String               @unique
  registration          WorkshopRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  
  financialStatus       String
  fulfillmentStatus     String?
  totalAmount           Float
  currency              String               @default("PHP")
  sku                   String
  quantity              Int
  rawPayload            String
  
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model RescheduleLog {
  id                      String               @id @default(uuid())
  registrationId          String
  registration            WorkshopRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  originalSessionId       String
  newSessionId            String
  reason                  String
  processedByStaffId      String
  processedByStaff        StaffUser            @relation(fields: [processedByStaffId], references: [id])
  createdAt               DateTime             @default(now())
}

model AuditTrail {
  id                      String                @id @default(uuid())
  registrationId          String?
  registration            WorkshopRegistration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  action                  String
  details                 String?
  performedByStaffId      String?
  performedByStaff        StaffUser?            @relation(fields: [performedByStaffId], references: [id])
  createdAt               DateTime              @default(now())
}
